{
  "name": "@anonhostpi/claude-browser-control-deno",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "dev": "deno run --watch --allow-read --allow-write --allow-env --allow-net --allow-run main.ts",
    "start": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run main.ts",
    "serve": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run main.ts serve",
    "mcp": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run main.ts mcp",
    "contracts": "deno run --allow-read main.ts contracts",
    "repl": "deno repl --allow-read --allow-write --allow-env --allow-net --allow-run --eval=\"import * as browser from './src/mod.ts'; await (async () => { const mod = await import('./src/mod.ts'); Object.assign(globalThis,mod); })();\"",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run",
    "test:watch": "deno test --watch --allow-read --allow-write --allow-env --allow-net --allow-run",
    "test:coverage": "deno test --coverage=coverage --allow-read --allow-write --allow-env --allow-net --allow-run",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/mod.ts main.ts",
    "doc": "deno doc --html --name='Claude Browser Control' --output=docs src/mod.ts",
    "transpile": "deno run --allow-read --allow-write src/orchestrator/transpile.ts --ts src/orchestrator/contracts/api.yaml src/orchestrator/contracts/api.ts"
  },
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.24.3",
    "@std/path": "jsr:@std/path@^1",
    "@std/jsonc": "jsr:@std/jsonc@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/yaml": "jsr:@std/yaml@^1.0.10",
    "@types/chrome-remote-interface": "npm:@types/chrome-remote-interface@^0.31.14",
    "ajv": "npm:ajv@^8.17.1",
    "chrome-remote-interface": "npm:chrome-remote-interface@^0.33.3",
    "devtools-protocol": "npm:devtools-protocol@^0.0.1551306",
    "hono": "jsr:@hono/hono@^4",
    "json-schema-to-ts": "npm:json-schema-to-ts@^3.1.1"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-unused-vars", "no-explicit-any", "explicit-function-return-type"]
    },
    "exclude": ["coverage/", "docs/"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": ["coverage/", "docs/"]
  },
  "test": {
    "include": ["src/**/*_test.ts"]
  }
}
